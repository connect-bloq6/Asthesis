# Copy to apps/web/.env.local and apps/admin/.env.local (or set in Amplify env for each app).
# Amplify monorepo: add SUPABASE_SERVICE_ROLE_KEY (exact name) to the Amplify app whose appRoot is apps/web, then redeploy.
# You may use a single file at the **monorepo root** `.env` / `.env.local`; `apps/web/next.config.js`
# loads that directory so the web app sees the same variables when you run `npm run dev -w web`.

# Use either the new publishable key or the legacy anon (JWT) key — not both required.

NEXT_PUBLIC_SUPABASE_URL=https://cpfuvposxgfotxnfsqio.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_lLZ5FogKa6D3qpliRu2Jqw__5S7LrTE

# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...  # optional legacy name

# apps/web — server-side only (never NEXT_PUBLIC_*). Required for resume uploads; also used to read
# published job_postings so the Impact careers list works reliably (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNwZnV2cG9zeGdmb3R4bmZzcWlvIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NDg0NTgyNywiZXhwIjoyMDkwNDIxODI3fQ.cHa0ylmsnY3UDRor1PI3yl3h8-kgZpxdm6CURwV9rUU

# apps/admin — optional. Public marketing site URL for links to job pages (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
