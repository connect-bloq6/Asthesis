# Copy to apps/web/.env.local and apps/admin/.env.local (or set in Amplify env for each app).
# Use either the new publishable key or the legacy anon (JWT) key — not both required.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...  # optional legacy name
