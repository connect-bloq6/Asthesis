{
  "name": "asthesis-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:admin": "npm run dev -w admin",
    "build:web": "npm run build -w web",
    "build:admin": "npm run build -w admin",
    "build": "npm run build:web && npm run build:admin",
    "lint:web": "npm run lint -w web",
    "video-to-frames": "npm run video-to-frames -w web"
  }
}
